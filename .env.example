# ==============================================================================
# BioSearch Platform — Environment Variables Template
# Copy this file to .env and configure your keys: cp .env.example .env
# ==============================================================================

# Google Gemini API Key for Biological Knowledge Graph Entity Synthesis
# Obtain a free API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# Model identifier for Gemini API (e.g. gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL="gemini-2.0-flash"

# Local Development Server Port
PORT=8080
